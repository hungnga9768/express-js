                async function generateAIQuestions() {
                  const topic = $('#ai-topic').val().trim();
                  const questionType = $('#ai-question-type').val();
                  const count = $('#ai-count').val();
                  const difficulty = $('#ai-difficulty').val();
                  const additional = $('#ai-additional').val().trim();
                  
                  if (!topic) {
                    alert('Vui lòng nhập chủ đề/nội dung');
                    return;
                  }
                  
                  // Show progress
                  $('#ai-form').hide();
                  $('#ai-progress').show();
                  $('#btn-generate-ai').prop('disabled', true);
                  
                  try {
                    const response = await fetch('/admin/baitap/ai/generate', {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json'
                      },
                      body: JSON.stringify({
                        topic,
                        questionType,
                        count: parseInt(count),
                        difficulty,
                        additional,
                        setId: '<%= baitap.set_id %>'
                      })
                    });
                    
                    const result = await response.json();
                    
                    if (result.success) {
                      displayAIResults(result.data);
                    } else {
                      throw new Error(result.message || 'Có lỗi xảy ra');
                    }
                  } catch (error) {
                    console.error('Error generating AI questions:', error);
                    alert('Lỗi khi tạo câu hỏi: ' + error.message);
                    
                    // Reset form
                    $('#ai-progress').hide();
                    $('#ai-form').show();
                    $('#btn-generate-ai').prop('disabled', false);
                  }
                }

                function displayAIResults(questions) {
                  $('#ai-progress').hide();
                  
                  let html = '';
                  questions.forEach((q, index) => {
                    html += `
                      <div class="card mb-3" data-question-index="${index}">
                        <div class="card-header">
                          <div class="d-flex justify-content-between align-items-center">
                            <strong>Câu ${index + 1}: ${q.exercise_type}</strong>
                            <div>
                              <button type="button" class="btn btn-sm btn-warning edit-ai-question" data-index="${index}">
                                <i class="fas fa-edit"></i> Sửa
                              </button>
                              <button type="button" class="btn btn-sm btn-danger remove-ai-question" data-index="${index}">
                                <i class="fas fa-trash"></i> Xóa
                              </button>
                            </div>
                          </div>
                        </div>
                        <div class="card-body">
                          <p><strong>Câu hỏi:</strong> ${q.question_text}</p>
                          ${q.options ? '<p><strong>Lựa chọn:</strong> ' + JSON.stringify(q.options) + '</p>' : ''}
                          <p><strong>Đáp án:</strong> ${q.correct_answer}</p>
                          ${q.explanation ? '<p><strong>Giải thích:</strong> ' + q.explanation + '</p>' : ''}
                        </div>
                      </div>
                    `;
                  });
                  
                  $('#ai-questions-preview').html(html);
                  $('#ai-results').show();
                  $('#btn-save-ai-questions').show();
                  
                  // Store questions data
                  window.aiGeneratedQuestions = questions;
                  
                  // Bind edit/remove events
                  $('.edit-ai-question').click(function() {
                    const index = $(this).data('index');
                    editAIQuestion(index);
                  });
                  
                  $('.remove-ai-question').click(function() {
                    const index = $(this).data('index');
                    removeAIQuestion(index);
                  });
                }

                function editAIQuestion(index) {
                  // Simple inline editing - you can enhance this
                  const question = window.aiGeneratedQuestions[index];
                  const newText = prompt('Sửa câu hỏi:', question.question_text);
                  if (newText && newText.trim()) {
                    window.aiGeneratedQuestions[index].question_text = newText.trim();
                    displayAIResults(window.aiGeneratedQuestions);
                  }
                }

                function removeAIQuestion(index) {
                  if (confirm('Bạn có chắc muốn xóa câu hỏi này?')) {
                    window.aiGeneratedQuestions.splice(index, 1);
                    displayAIResults(window.aiGeneratedQuestions);
                  }
                }

                async function saveAIQuestions() {
                  if (!window.aiGeneratedQuestions || window.aiGeneratedQuestions.length === 0) {
                    alert('Không có câu hỏi nào để lưu');
                    return;
                  }
                  
                  $('#btn-save-ai-questions').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');
                  
                  try {
                    const response = await fetch('/admin/baitap/ai/save-questions', {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json'
                      },
                      body: JSON.stringify({
                        questions: window.aiGeneratedQuestions,
                        setId: '<%= baitap.set_id %>'
                      })
                    });
                    
                    const result = await response.json();
                    
                    if (result.success) {
                      alert('Đã lưu thành công ' + result.saved + ' câu hỏi!');
                      $('#aiQuestionModal').modal('hide');
                      location.reload(); // Reload to show new questions
                    } else {
                      throw new Error(result.message || 'Có lỗi xảy ra khi lưu');
                    }
                  } catch (error) {
                    console.error('Error saving AI questions:', error);
                    alert('Lỗi khi lưu câu hỏi: ' + error.message);
                  } finally {
                    $('#btn-save-ai-questions').prop('disabled', false).html('<i class="fas fa-save"></i> Lưu tất cả câu hỏi');
                  }
                }
              })();
            </script>

          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('footer') %>
