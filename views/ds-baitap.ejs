<%- include('header')%> <%- include('aside')%>

<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1><%= title %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin">Trang chủ</a></li>
            <li class="breadcrumb-item active">Bài tập</li>
          </ol>
        </div>
      </div>
    </div>
  </section>
  <!-- Main content -->
  <section class="content">
    <!-- Default box -->
    <div class="box">
      <div class="box-body">
        <form action="" method="GET" class="form-inline" role="form">
          <div class="form-group">
            <input
              class="form-control"
              name="search"
              placeholder="Tìm kiếm bài tập"
              value="<%= search %>"
            />
          </div>

          <button type="submit" class="btn btn-primary">
            <i class="fa fa-search"></i> Tìm kiếm
          </button>
          <a href="/admin/baitap/add" class="btn btn-success pull-right">
            <i class="fa fa-plus"></i> Thêm bộ bài tập
          </a>
        </form>
      </div>

      <div class="box-body">
        <table class="table table-bordered table-hover">
          <thead class="thead-light">
            <tr>
              <th>ID</th>
              <th>Bài học</th>
              <th>Tiêu đề</th>
              <th>Mô tả</th>
              <th style="width:180px">Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% if (data && data.length > 0) { %>
              <% data.forEach(function(baitap) { %>
                <tr>
                  <td><%= baitap.set_id %></td>
                  <td>
                    <%= (listbaihoc.find(baihoc => baihoc.lesson_id === baitap.lesson_id) || {}).title || "Không rõ" %>
                  </td>
                  <td><%= baitap.title %></td>
                  <td><%= baitap.description || '' %></td>
                  <td>
                    <a
                      href="/admin/baitap/edit/<%= baitap.set_id %>"
                      class="btn btn-sm btn-warning"
                      title="Sửa bộ bài tập và câu hỏi"
                    >
                      <i class="fa fa-edit"></i> Sửa
                    </a>
                    <form
                      action="/admin/baitap/delete/<%= baitap.set_id %>"
                      method="POST"
                      style="display: inline-block"
                      onsubmit="return confirm('Bạn có chắc muốn xóa bộ bài tập này không?');"
                    >
                      <button class="btn btn-sm btn-danger" type="submit">
                        <i class="fa fa-trash"></i> Xóa
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center">Không có bộ bài tập nào.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="box-footer text-center">
        <ul class="pagination d-flex justify-content-center">
          <!-- Previous -->
          <li class="paginate_button page-item previous <%= Page === 1 ? 'disabled' : '' %>">
            <a
              href="?page=<%= Page > 1 ? Page - 1 : 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
              class="page-link"
            >Previous</a>
          </li>

          <!-- Page numbers -->
          <% for (let i = 1; i <= totalPage; i++) { %>
            <li class="paginate_button page-item <%= i === Page ? 'active' : '' %>">
              <a
                href="?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                class="page-link"
              ><%= i %></a>
            </li>
          <% } %>

          <!-- Next -->
          <li class="paginate_button page-item next <%= Page === totalPage ? 'disabled' : '' %>">
            <a
              href="?page=<%= Page < totalPage ? Page + 1 : totalPage %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
              class="page-link"
            >Next</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</div>
<%- include('footer')%>