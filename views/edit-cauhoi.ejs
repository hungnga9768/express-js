    function updateDragDropMapping(){
      const dragItems = [...document.querySelectorAll('.drag-item')].map(el => el.value || el.placeholder);
      const dropTargets = [...document.querySelectorAll('.drop-target')].map(el => el.value || el.placeholder);
      const mappingDiv = document.getElementById('drag_drop_mapping');
      
      mappingDiv.innerHTML = '';
      dragItems.forEach((item, i) => {
        const div = document.createElement('div');
        div.className = 'form-group';
        div.innerHTML = `
          <label>${item} → </label>
          <select class="form-control drag-mapping" data-drag-index="${i}">
            <option value="">Chọn vùng đích...</option>
            ${dropTargets.map((target, j) => `<option value="${j}">${target}</option>`).join('')}
          </select>
        `;
        mappingDiv.appendChild(div);
      });
    }

    // Auto-extract fill blank answers from question
    function extractFillBlankAnswers() {
      const questionText = document.querySelector('textarea[name="question"]').value;
      const extractedDiv = document.getElementById('fb_extracted_answers');
      
      if (!questionText.trim()) {
        extractedDiv.innerHTML = '<em class="text-muted">Nhập câu hỏi với ký hiệu *từ* để xem đáp án...</em>';
        return;
      }

      // Extract answers between * symbols
      const answerMatches = questionText.match(/\*([^*]+)\*/g);
      
      if (answerMatches && answerMatches.length > 0) {
        const answers = answerMatches.map(match => match.replace(/\*/g, '').trim());
        extractedDiv.innerHTML = `
          <div class="d-flex flex-wrap gap-2">
            ${answers.map((answer, index) => 
              `<span class="badge badge-primary">${index + 1}. ${answer}</span>`
            ).join('')}
          </div>
          <small class="text-success mt-1 d-block">✓ Tìm thấy ${answers.length} đáp án</small>
        `;
      } else {
        extractedDiv.innerHTML = '<em class="text-warning">Không tìm thấy đáp án. Hãy sử dụng ký hiệu *từ* trong câu hỏi.</em>';
      }
    }

    // Add event listeners for dynamic updates
    document.addEventListener('input', function(e) {
      if (e.target.classList.contains('drag-item') || e.target.classList.contains('drop-target')) {
        updateDragDropMapping();
      }
      
      // Update matching mapping when left/right items change
      if (e.target.classList.contains('match-left') || e.target.classList.contains('match-right')) {
        updateMatchMapping();
      }
      
      // Preview images when URL is entered
      if (e.target.classList.contains('image-url') || e.target.classList.contains('sequence-image-url')) {
        const url = e.target.value.trim();
        const previewDiv = e.target.closest('.image-option-item, .sequence-item').querySelector('.image-preview, .sequence-preview');
        if (url && previewDiv) {
          previewDiv.innerHTML = `<img src="${url}" style="max-width: 100%; max-height: 100%; object-fit: cover;" onerror="this.style.display='none'">`;
        } else if (previewDiv) {
          previewDiv.innerHTML = '';
        }
      }

      // Auto-extract fill blank answers from question
      if (e.target.name === 'question' && typeSelect.value === 'fill_blank') {
        extractFillBlankAnswers();
      }
    });

    // Pre-fill existing data
    function prefillExistingData() {
      const existingType = '<%= cauhoi.exercise_type %>';
      const existingOptions = `<%- JSON.stringify(cauhoi.options || '') %>`.replace(/&quot;/g, '"').replace(/&#x27;/g, "'");
      const existingCorrectAnswer = `<%- JSON.stringify(cauhoi.correct_answer || '') %>`.replace(/&quot;/g, '"').replace(/&#x27;/g, "'");

      console.log('Prefilling data:', { existingType, existingOptions, existingCorrectAnswer });

      // Show the correct type block
      renderBlocks();

      try {
        // Parse the JSON strings properly
        let parsedOptions = null;
        let parsedCorrectAnswer = null;
        
        if (existingOptions && existingOptions !== '""' && existingOptions !== 'null') {
          try {
            parsedOptions = JSON.parse(existingOptions);
          } catch (e) {
            console.warn('Error parsing options:', e, existingOptions);
          }
        }
        
        if (existingCorrectAnswer && existingCorrectAnswer !== '""' && existingCorrectAnswer !== 'null') {
          try {
            parsedCorrectAnswer = JSON.parse(existingCorrectAnswer);
          } catch (e) {
            // If it's not JSON, use as string
            parsedCorrectAnswer = existingCorrectAnswer.replace(/"/g, '');
          }
        }
        
        console.log('Parsed data:', { parsedOptions, parsedCorrectAnswer });

        // MULTIPLE CHOICE
        if (existingType === 'multiple_choice') {
          if (parsedOptions && Array.isArray(parsedOptions)) {
            document.getElementById('mc_optionA').value = parsedOptions[0] || '';
            document.getElementById('mc_optionB').value = parsedOptions[1] || '';
            document.getElementById('mc_optionC').value = parsedOptions[2] || '';
            document.getElementById('mc_optionD').value = parsedOptions[3] || '';
          }
          document.getElementById('mc_correct').value = parsedCorrectAnswer || 'A';
        }
        
        // TRUE/FALSE
        else if (existingType === 'true_false') {
          document.getElementById('tf_correct').value = parsedCorrectAnswer || 'true';
        }
        
        // FILL BLANK - Restore original question with * markers
        else if (existingType === 'fill_blank') {
          if (parsedCorrectAnswer && Array.isArray(parsedCorrectAnswer) && parsedCorrectAnswer.length > 0) {
            // Get current question text (should have ___ placeholders)
            const currentQuestion = document.querySelector('textarea[name="question"]').value;
            
            // Replace ___ with *answer* to show original format
            let restoredQuestion = currentQuestion;
            parsedCorrectAnswer.forEach(answer => {
              restoredQuestion = restoredQuestion.replace('___', `*${answer}*`);
            });
            
            // Update question field
            document.querySelector('textarea[name="question"]').value = restoredQuestion;
            
            // Trigger extraction to show answers
            setTimeout(() => {
              extractFillBlankAnswers();
            }, 100);
          }
        }
        
        // MATCHING
        else if (existingType === 'matching') {
          if (parsedOptions && parsedOptions.leftItems && parsedOptions.rightItems) {
              // Clear existing items first
              document.getElementById('match_left_items').innerHTML = '';
              document.getElementById('match_right_items').innerHTML = '';
              
              // Add first items (containers already have one input each)
              const leftContainer = document.getElementById('match_left_items');
              const rightContainer = document.getElementById('match_right_items');
              
            // Add left items
            parsedOptions.leftItems.forEach((item, index) => {
              if (index === 0) {
                // Create first item
                leftContainer.innerHTML = `
                  <div class="input-group mb-2">
                    <input type="text" class="form-control match-left" placeholder="Mục trái 1" value="${item}">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeMatchItem(this, 'left')">×</button>
                  </div>
                `;
              } else {
                addMatchItem('left');
                const leftInputs = document.querySelectorAll('.match-left');
                leftInputs[leftInputs.length - 1].value = item;
              }
            });
            
            // Add right items
            parsedOptions.rightItems.forEach((item, index) => {
              if (index === 0) {
                // Create first item
                rightContainer.innerHTML = `
                  <div class="input-group mb-2">
                    <input type="text" class="form-control match-right" placeholder="Mục phải 1" value="${item}">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeMatchItem(this, 'right')">×</button>
                  </div>
                `;
              } else {
                addMatchItem('right');
                const rightInputs = document.querySelectorAll('.match-right');
                rightInputs[rightInputs.length - 1].value = item;
              }
            });
            
            // Update mapping interface
            setTimeout(() => {
              updateMatchMapping();
              
              // Set correct mappings
              if (parsedCorrectAnswer && typeof parsedCorrectAnswer === 'object') {
                setTimeout(() => {
                  Object.entries(parsedCorrectAnswer).forEach(([left, right]) => {
                    const select = document.querySelector(`[data-left="${left}"]`);
                    if (select) {
                      select.value = right;
                    }
                  });
                  updateMappingPreview();
                }, 200);
              }
            }, 100);
          }
        }
        
        // ORDERING
        else if (existingType === 'ordering') {
          let itemsToShow = [];
          
          if (parsedOptions && parsedOptions.items && Array.isArray(parsedOptions.items)) {
            itemsToShow = parsedOptions.items;
          }
          
          // Fallback: use correct_answer if options not available
          if (itemsToShow.length === 0 && parsedCorrectAnswer) {
            if (Array.isArray(parsedCorrectAnswer)) {
              itemsToShow = parsedCorrectAnswer;
            } else if (typeof parsedCorrectAnswer === 'string') {
              itemsToShow = [parsedCorrectAnswer];
            }
          }
          
          if (itemsToShow.length > 0) {
            // Handle items that might contain "/" as separators
            let finalItems = [];
            itemsToShow.forEach(item => {
              if (typeof item === 'string' && item.includes('/')) {
                // Split by "/" and add each part as separate item
                finalItems.push(...item.split('/').map(s => s.trim()).filter(Boolean));
              } else {
                finalItems.push(item);
              }
            });
            
            document.getElementById('ordering_items').value = finalItems.join('\n');
          }
        }
        
        // DRAG & DROP
        else if (existingType === 'drag_drop') {
          if (parsedOptions && parsedOptions.dragItems && parsedOptions.dropTargets && 
