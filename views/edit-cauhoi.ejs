              } else if (typeof card === 'string') {
                // Format: "front: back" or just "card"
                const parts = card.split(':');
                frontValue = parts[0] ? parts[0].trim() : card;
                backValue = parts[1] ? parts[1].trim() : '';
              }
              
              div.innerHTML = `
                <div class="row">
                  <div class="col-md-6">
                    <label>Mặt trước/Câu hỏi</label>
