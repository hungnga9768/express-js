        // IMAGE SEQUENCING
        else if (existingType === 'image_sequencing') {
          if (parsedOptions && parsedOptions.sequences && Array.isArray(parsedOptions.sequences)) {
            const container = document.getElementById('image_sequence_container');
            container.innerHTML = '';
            
            parsedOptions.sequences.forEach((seq, index) => {
