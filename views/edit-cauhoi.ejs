              } else {
                addDropTarget();
                const dropInputs = document.querySelectorAll('.drop-target');
                dropInputs[dropInputs.length - 1].value = item;
              }
            });
            
            setTimeout(() => {
              updateDragDropMapping();
              
              // Set existing mappings if available in correct_answer
              if (parsedCorrectAnswer && typeof parsedCorrectAnswer === 'object') {
                // Set drag-drop mappings based on correct answer
                Object.entries(parsedCorrectAnswer).forEach(([dragItem, dropTarget]) => {
                  const dragIndex = parsedOptions.dragItems.indexOf(dragItem);
                  const dropIndex = parsedOptions.dropTargets.indexOf(dropTarget);
                  if (dragIndex >= 0 && dropIndex >= 0) {
                    const select = document.querySelector(`[data-drag-index="${dragIndex}"]`);
                    if (select) {
                      select.value = dropIndex;
                    }
                  }
                });
              }
            }, 200);
          }
        }
        
        // IMAGE CHOICE
        else if (existingType === 'image_choice') {
          if (parsedOptions && parsedOptions.images && Array.isArray(parsedOptions.images)) {
            const container = document.getElementById('image_options_container');
            const choiceType = document.getElementById('image_choice_type');
            
            // Set choice type
            if (parsedOptions.type) {
              choiceType.value = parsedOptions.type;
