                    <input type="text" class="form-control mt-2 image-caption" placeholder="Mô tả ảnh (tùy chọn)" value="${img.caption || ''}">
                  </div>
                  <div class="col-md-4">
                    <div class="form-check">
                      <input type="checkbox" class="form-check-input image-correct" ${(parsedCorrectAnswer === index || (Array.isArray(parsedCorrectAnswer) && parsedCorrectAnswer.includes(index))) ? 'checked' : ''}>
                      <label class="form-check-label">Đáp án đúng</label>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mt-2" onclick="removeImageOption(this)">Xóa</button>
                  </div>
                </div>
                <div class="image-preview mt-2" style="max-width: 200px; max-height: 150px; overflow: hidden;">
                  ${img.url ? `<img src="${img.url}" style="max-width: 100%; max-height: 100%; object-fit: cover;" onerror="this.style.display='none'">` : ''}
                </div>
              `;
              container.appendChild(div);
            });
          }
        }
        
        // DIALOG CARDS
        else if (existingType === 'dialog_cards') {
          if (parsedOptions && parsedOptions.cards && Array.isArray(parsedOptions.cards)) {
            const container = document.getElementById('dialog_cards_container');
