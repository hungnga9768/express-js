<%- include('footer')%>

<script>

// Biến global để theo dõi trạng thái sắp xếp
let isOrderMode = false;
let sortableInstance = null;

// Debug function để kiểm tra trạng thái
function debugSortableState() {
  console.log('🔍 Debug Sortable State:');
  console.log('- isOrderMode:', isOrderMode);
  console.log('- sortableInstance:', sortableInstance);
  console.log('- Sortable library loaded:', typeof Sortable !== 'undefined');
  console.log('- Questions list element:', document.getElementById('questionsList'));
  console.log('- Order badges:', document.querySelectorAll('.question-order-badge').length);
}

// Hiển thị modal import
function showImportModal() {
  const modal = document.getElementById('importModal');
  if (modal && typeof $ !== 'undefined') {
    $('#importModal').modal('show');
  } else if (modal) {
    modal.style.display = 'block';
    modal.classList.add('show');
  }
}

// Toggle chế độ sắp xếp
function toggleQuestionOrder() {
  const toggleBtn = document.getElementById('toggleOrderBtn');
  const questionsList = document.getElementById('questionsList');
  const orderBadges = document.querySelectorAll('.question-order-badge');
  
  isOrderMode = !isOrderMode;
  
  if (isOrderMode) {
    // Bật chế độ sắp xếp
    toggleBtn.innerHTML = '<i class="fas fa-save"></i> Lưu thứ tự';
    toggleBtn.className = 'btn btn-sm btn-success';
    
    // Hiển thị badge thứ tự
    orderBadges.forEach(badge => {
      badge.style.display = 'inline-block';
    });
    
    // Thêm class cho drag & drop
    questionsList.classList.add('sortable-mode');
    
    // Khởi tạo Sortable.js
    if (typeof Sortable !== 'undefined') {
      sortableInstance = Sortable.create(questionsList, {
        animation: 150,
        ghostClass: 'sortable-ghost',
        chosenClass: 'sortable-chosen',
        dragClass: 'sortable-drag',
        handle: '.question-order-badge',
        onStart: function(evt) {
          // Thêm visual feedback khi bắt đầu kéo
          evt.item.classList.add('dragging');
        },
        onEnd: function(evt) {
          // Xóa visual feedback
          evt.item.classList.remove('dragging');
          // Cập nhật số thứ tự
          updateOrderNumbers();
        },
        onMove: function(evt) {
          // Kiểm tra xem có thể di chuyển không
          return true;
        }
      });
      
      console.log('✅ Sortable initialized successfully');
    } else {
      console.error('❌ Sortable.js not loaded');
      showNotification('Lỗi: Sortable.js chưa được tải!', 'error');
      return;
    }
    
    // Hiển thị thông báo
    showNotification('Chế độ sắp xếp đã bật. Kéo thả badge thứ tự để sắp xếp câu hỏi.', 'info');
    
  } else {
    // Tắt chế độ sắp xếp và lưu
    toggleBtn.innerHTML = '<i class="fas fa-sort"></i> Sắp xếp';
    toggleBtn.className = 'btn btn-sm btn-outline-secondary';
    
    // Ẩn badge thứ tự
    orderBadges.forEach(badge => {
      badge.style.display = 'none';
    });
    
    // Xóa class drag & drop
    questionsList.classList.remove('sortable-mode');
    
    // Hủy Sortable instance
    if (sortableInstance) {
      sortableInstance.destroy();
      sortableInstance = null;
      console.log('✅ Sortable destroyed');
    }
    
    // Lưu thứ tự mới
    saveNewOrder();
  }
}

// Cập nhật số thứ tự hiển thị
function updateOrderNumbers() {
  const questionCards = document.querySelectorAll('.question-card');
  questionCards.forEach((card, index) => {
    const orderNumber = card.querySelector('.order-number');
    if (orderNumber) {
      orderNumber.textContent = index + 1;
      // Cập nhật data-order attribute
      card.setAttribute('data-order', index + 1);
    }
  });
  
  console.log(`✅ Updated order numbers for ${questionCards.length} questions`);
}

// Lưu thứ tự mới lên server
function saveNewOrder() {
  const questionCards = document.querySelectorAll('.question-card');
  const orders = [];
  
  questionCards.forEach((card, index) => {
    const questionId = card.getAttribute('data-question-id');
    const currentOrder = card.getAttribute('data-order');
    
    orders.push({
      question_id: parseInt(questionId),
      order_in_test: index + 1,
      previous_order: parseInt(currentOrder) || 0
    });
  });
  
  console.log('📤 Sending order data:', orders);
  
  // Hiển thị loading
  showNotification('Đang lưu thứ tự mới...', 'info');
  
  // Gửi request lên server
  const requestData = { orders: orders };
  console.log('📤 Request data:', requestData);
  console.log('📤 Request URL:', `/admin/hsk/<%= test.test_id %>/questions/reorder`);
  
  fetch(`/admin/hsk/<%= test.test_id %>/questions/reorder`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(requestData)
  })
  .then(response => {
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    return response.json();
  })
  .then(data => {
    if (data.success) {
      showNotification('Đã lưu thứ tự mới thành công!', 'success');
      console.log('✅ Order saved successfully:', data);
      // Reload trang để cập nhật
      setTimeout(() => {
        location.reload();
      }, 1500);
    } else {
      showNotification('Lỗi khi lưu thứ tự: ' + (data.message || 'Không xác định'), 'error');
      console.error('❌ Server error:', data);
    }
  })
  .catch(error => {
    console.error('❌ Error saving order:', error);
    showNotification('Lỗi khi lưu thứ tự mới: ' + error.message, 'error');
  });
}

// Hiển thị thông báo
function showNotification(message, type = 'info') {
  // Tạo toast notification
  const toast = document.createElement('div');
  toast.className = `alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed`;
  toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
  toast.innerHTML = `
    ${message}
    <button type="button" class="close" data-dismiss="alert">
      <span>&times;</span>
    </button>
  `;
  
  document.body.appendChild(toast);
  
  // Tự động ẩn sau 3 giây
  setTimeout(() => {
    if (toast.parentNode) {
      toast.parentNode.removeChild(toast);
    }
  }, 3000);
}

// Preview CSV data
function previewCSV() {
  const csvContent = document.getElementById('csvContent').value.trim();
  if (!csvContent) {
    alert('Vui lòng nhập nội dung CSV hoặc chọn file!');
    return;
  }
  
  try {
    const lines = csvContent.split('\n');
    const headers = lines[0].split(',').map(h => h.trim().replace(/"/g, ''));
    const data = lines.slice(1).map(line => {
      const values = line.split(',').map(v => v.trim().replace(/"/g, ''));
      const row = {};
      headers.forEach((header, index) => {
        row[header] = values[index] || '';
      });
      return row;
    });
    
    // Hiển thị preview
    const tbody = document.getElementById('previewTable').querySelector('tbody');
    tbody.innerHTML = '';
    
    data.slice(0, 5).forEach(row => { // Chỉ hiển thị 5 dòng đầu
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${row['Loại kỹ năng'] || ''}</td>
        <td>${row['Loại câu hỏi'] || ''}</td>
        <td>${(row['Nội dung'] || '').substring(0, 50)}...</td>
        <td>${row['Đáp án đúng'] || ''}</td>
        <td>${row['Điểm'] || ''}</td>
      `;
      tbody.appendChild(tr);
    });
    
    if (data.length > 5) {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td colspan="5" class="text-center text-muted">... và ${data.length - 5} dòng khác</td>`;
      tbody.appendChild(tr);
    }
    
    document.getElementById('previewData').style.display = 'block';
    
  } catch (error) {
    console.error('Error parsing CSV:', error);
    alert('Lỗi khi parse CSV. Vui lòng kiểm tra định dạng file!');
  }
}

// Import questions
function importQuestions() {
  const csvContent = document.getElementById('csvContent').value.trim();
  if (!csvContent) {
    alert('Vui lòng nhập nội dung CSV!');
    return;
  }
  
  if (confirm(`Bạn có chắc muốn import câu hỏi? Hệ thống sẽ thêm ${csvContent.split('\n').length - 1} câu hỏi mới.`)) {
    // Gửi dữ liệu lên server
    fetch(`/admin/hsk/<%= test.test_id %>/questions/import`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: `csvData=${encodeURIComponent(csvContent)}`
    })
    .then(response => {
      if (response.ok) {
        alert('Import câu hỏi thành công!');
        $('#importModal').modal('hide');
        location.reload();
      } else {
        alert('Có lỗi xảy ra khi import câu hỏi!');
      }
    })
    .catch(error => {
      console.error('Error importing questions:', error);
      alert('Có lỗi xảy ra khi import câu hỏi!');
    });
  }
}

function updateQuestionForm() {
  const type = document.getElementById('question_type').value;
  
  // Hiển thị/ẩn các nhóm tùy chọn
  document.getElementById('options-group').style.display = (type === 'multiple_choice') ? '' : 'none';
  document.getElementById('matching-group').style.display = (type === 'matching') ? '' : 'none';
  document.getElementById('ordering-group').style.display = (type === 'ordering') ? '' : 'none';
  document.getElementById('rewrite-group').style.display = (type === 'rewrite') ? '' : 'none';
  document.getElementById('blanks-container').style.display = (type === 'fill_blank' || type === 'cloze') ? '' : 'none';
  document.getElementById('addBlankBtn').style.display = (type === 'fill_blank' || type === 'cloze') ? '' : 'none';
  document.getElementById('fill-blank-hint').style.display = (type === 'fill_blank' || type === 'cloze') ? '' : 'none';

  // Xử lý hiển thị các nhóm đáp án
  const answerTextGroup = document.getElementById('answer-text-group');
  const trueFalseGroup = document.getElementById('true-false-group');
  const answerTextInput = document.getElementById('answer-text-input');
  const answerTextHint = document.getElementById('answer-text-hint');
  
  // Ẩn tất cả các nhóm đáp án trước
  answerTextGroup.style.display = 'none';
  trueFalseGroup.style.display = 'none';
  
  // Reset required attributes cho tất cả các field
  if (answerTextInput) answerTextInput.required = false;
  const trueFalseSelect = document.getElementById('true-false-select');
  if (trueFalseSelect) trueFalseSelect.required = false;
  
  // Reset required cho radio buttons
  const radioButtons = document.querySelectorAll('input[name="correct_answer_multiple_choice"]');
  radioButtons.forEach(radio => {
    radio.required = false;
  });
  
  if (type === 'true_false') {
    // Hiển thị select box cho True/False
    trueFalseGroup.style.display = '';
    if (trueFalseSelect) trueFalseSelect.required = true;
  } else if (['ordering', 'rewrite'].includes(type)) {
    // Hiển thị input text cho ordering và rewrite (không phải matching)
    answerTextGroup.style.display = '';
    if (answerTextInput) answerTextInput.required = true;
    
    if (type === 'ordering') {
      answerTextHint.innerText = 'Nhập thứ tự đúng, ví dụ: 2,1,3,4.';
    } else if (type === 'rewrite') {
      answerTextHint.innerText = 'Nhập đáp án mẫu hoặc yêu cầu viết lại.';
    }
  } else if (type === 'multiple_choice') {
    // Set required cho radio buttons của trắc nghiệm
    radioButtons.forEach(radio => {
      radio.required = true;
    });
  }
  // Note: matching không hiển thị answer-text-group vì đã có phần cấu hình đáp án riêng
}

function initializeEditForm() {
  // Khởi tạo form với dữ liệu hiện tại khi edit
  <% if (typeof isEditMode !== 'undefined' && isEditMode && editQuestion) { %>
    const editData = <%- JSON.stringify(editQuestion) %>;
    
    console.log('🔍 Debug initializeEditForm - editData:', editData);
    
    // Điền các field cơ bản
    if (editData.question_text) {
      const questionTextArea = document.querySelector('textarea[name="question_text"]');
      if (questionTextArea) {
        questionTextArea.value = editData.question_text;
        console.log('✅ Filled question_text:', editData.question_text);
      }
    }
    
    if (editData.points) {
      const pointsInput = document.querySelector('input[name="points"]');
      if (pointsInput) {
        pointsInput.value = editData.points;
        console.log('✅ Filled points:', editData.points);
      }
    }
    
    if (editData.order_in_test !== undefined) {
      const orderInput = document.querySelector('input[name="order_in_test"]');
      if (orderInput) {
        orderInput.value = editData.order_in_test;
        console.log('✅ Filled order_in_test:', editData.order_in_test);
      }
    }
    
    if (editData.explanation) {
      const explanationTextArea = document.querySelector('textarea[name="explanation"]');
      if (explanationTextArea) {
        explanationTextArea.value = editData.explanation;
        console.log('✅ Filled explanation:', editData.explanation);
      }
    }
    
    // Set skill_type và question_type
    if (editData.skill_type) {
      const skillSelect = document.querySelector('select[name="skill_type"]');
      if (skillSelect) {
        skillSelect.value = editData.skill_type;
        console.log('✅ Set skill_type:', editData.skill_type);
      }
    }
    
    if (editData.question_type) {
      const questionTypeSelect = document.getElementById('question_type');
      if (questionTypeSelect) {
        questionTypeSelect.value = editData.question_type;
        console.log('✅ Set question_type:', editData.question_type);
        // Trigger change event để hiển thị đúng section
        updateQuestionForm();
      }
    }
    
    // Xử lý theo từng loại câu hỏi - Đợi form update xong rồi mới fill data
    setTimeout(() => {
      if (editData.question_type === 'multiple_choice' && editData.options) {
        console.log('🔍 Processing multiple_choice options:', editData.options);
        // Điền options cho multiple choice
        editData.options.forEach((option, index) => {
          const optionInput = document.querySelector(`input[name="option_${String.fromCharCode(65 + index)}"]`);
          if (optionInput) {
            optionInput.value = option;
            console.log(`✅ Filled option_${String.fromCharCode(65 + index)}:`, option);
          }
        });
        
        // Chọn đáp án đúng
        if (editData.correct_answer) {
          const correctRadio = document.querySelector(`input[name="correct_answer_multiple_choice"][value="${editData.correct_answer}"]`);
          if (correctRadio) {
            correctRadio.checked = true;
            console.log('✅ Set correct_answer_multiple_choice:', editData.correct_answer);
          }
        }
      } else if (editData.question_type === 'matching' && editData.matching_pairs) {
        console.log('🔍 Processing matching_pairs:', editData.matching_pairs);
        // Clear existing pairs first
        clearMatchingPairs();
        
        // Điền matching pairs
        editData.matching_pairs.forEach((pair, index) => {
          addMatchingPair(); // Add new pair elements
          const leftInput = document.querySelector(`input[name="matching_left_${index + 1}"]`);
          const rightInput = document.querySelector(`input[name="matching_right_${index + 1}"]`);
          if (leftInput) {
            leftInput.value = pair.left;
            console.log(`✅ Filled matching_left_${index + 1}:`, pair.left);
          }
          if (rightInput) {
            rightInput.value = pair.right;
            console.log(`✅ Filled matching_right_${index + 1}:`, pair.right);
          }
        });
        
        // Update matching answers if correct_answer exists
        if (editData.correct_answer) {
          console.log('🔍 Processing matching correct_answer:', editData.correct_answer);
          // Parse correct_answer format like "A-1,B-2,C-3,D-4"
          const answers = editData.correct_answer.split(',');
          answers.forEach(ans => {
            const [letter, num] = ans.split('-');
            const index = letter.charCodeAt(0) - 65; // A=0, B=1, C=2, D=3
            const select = document.querySelector(`select[name="matching_answer_${index + 1}"]`);
            if (select) {
              select.value = num;
              console.log(`✅ Set matching_answer_${index + 1}:`, num);
            }
          });
        }
      } else if (editData.question_type === 'ordering' && editData.ordering_items) {
        console.log('🔍 Processing ordering_items:', editData.ordering_items);
        // Clear existing items first
        const orderingContainer = document.getElementById('ordering-items-container');
        if (orderingContainer) {
          orderingContainer.innerHTML = '';
        }
        
        // Điền ordering items
        editData.ordering_items.forEach((item, index) => {
          addOrderingItem(); // Add new item elements
          const itemInput = document.querySelector(`input[name="ordering_item_${index + 1}"]`);
          if (itemInput) {
            itemInput.value = item;
            console.log(`✅ Filled ordering_item_${index + 1}:`, item);
          }
        });
        
        // Fill correct answer for ordering
        if (editData.correct_answer) {
          const answerInput = document.getElementById('answer-text-input');
          if (answerInput) {
            answerInput.value = editData.correct_answer;
            console.log('✅ Filled ordering correct_answer:', editData.correct_answer);
          }
        }
      } else if (editData.question_type === 'rewrite' && editData.rewrite_instruction) {
        console.log('🔍 Processing rewrite_instruction:', editData.rewrite_instruction);
        const instructionInput = document.querySelector('textarea[name="rewrite_instruction"]');
        if (instructionInput) {
          instructionInput.value = editData.rewrite_instruction;
          console.log('✅ Filled rewrite_instruction:', editData.rewrite_instruction);
        }
        
        // Fill correct answer for rewrite
        if (editData.correct_answer) {
          const answerInput = document.getElementById('answer-text-input');
          if (answerInput) {
            answerInput.value = editData.correct_answer;
            console.log('✅ Filled rewrite correct_answer:', editData.correct_answer);
          }
        }
      } else if (editData.question_type === 'true_false') {
        console.log('🔍 Processing true_false correct_answer:', editData.correct_answer);
        const trueFalseSelect = document.getElementById('true-false-select');
        if (trueFalseSelect && editData.correct_answer) {
          trueFalseSelect.value = editData.correct_answer;
          console.log('✅ Set true_false correct_answer:', editData.correct_answer);
        }
      } else if (editData.question_type === 'fill_blank' && editData.options) {
        console.log('🔍 Processing fill_blank options:', editData.options);
        // Clear existing blanks first
        const blanksContainer = document.getElementById('blanks-container');
        if (blanksContainer) {
          blanksContainer.innerHTML = '';
        }
        
        // Điền fill blank options
        editData.options.forEach((blankOptions, blankIndex) => {
          addBlank(); // Add new blank group
          blankOptions.forEach((option, optionIndex) => {
            const optionInput = document.querySelector(`input[name="option_${blankIndex + 1}_${String.fromCharCode(65 + optionIndex)}"]`);
            if (optionInput) {
              optionInput.value = option;
              console.log(`✅ Filled option_${blankIndex + 1}_${String.fromCharCode(65 + optionIndex)}:`, option);
            }
          });
          
          // Set correct answer for this blank
          if (editData.correct_answer) {
            const answers = editData.correct_answer.split(',');
            const correctAnswer = answers[blankIndex];
            if (correctAnswer) {
              const correctRadio = document.querySelector(`input[name="correct_answer_${blankIndex + 1}"][value="${correctAnswer}"]`);
              if (correctRadio) {
                correctRadio.checked = true;
                console.log(`✅ Set correct_answer_${blankIndex + 1}:`, correctAnswer);
              }
            }
          }
        });
      }
      
      // Điền đáp án đúng chung (nếu có)
      if (editData.correct_answer && !['multiple_choice', 'matching', 'true_false'].includes(editData.question_type)) {
        const answerInput = document.getElementById('answer-text-input');
        if (answerInput) {
          answerInput.value = editData.correct_answer;
          console.log('✅ Filled general correct_answer:', editData.correct_answer);
        }
      }
      
      console.log('✅ initializeEditForm completed');
    }, 200); // Đợi 200ms để form update xong
    
    console.log('✅ initializeEditForm completed');
  <% } %>
}
document.addEventListener('DOMContentLoaded', function() {
  updateQuestionForm();
  const questionTypeSelect = document.getElementById('question_type');
  if (questionTypeSelect) {
    questionTypeSelect.addEventListener('change', updateQuestionForm);
  }
  
  // Nếu đang ở chế độ edit, khởi tạo form với dữ liệu hiện tại
