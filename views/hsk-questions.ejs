        <div class="form-group">
          <label for="csvContent">Hoặc paste nội dung CSV trực tiếp</label>
          <textarea class="form-control" id="csvContent" rows="10" placeholder="Paste nội dung CSV vào đây..."></textarea>
        </div>
        
        <div id="previewData" style="display: none;">
          <h6>Preview dữ liệu:</h6>
