<%- include('header') %>
<%- include('aside') %>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0">Thống kê thanh toán</h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin/">Home</a></li>
            <li class="breadcrumb-item"><a href="/admin/payments">Quản lý thanh toán</a></li>
            <li class="breadcrumb-item active">Thống kê</li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      
      <!-- Filter -->
      <div class="row mb-3">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <form method="GET" class="form-inline">
                <div class="form-group mr-3">
                  <label for="period" class="mr-2">Thời gian:</label>
                  <select name="period" id="period" class="form-control">
                    <option value="7" <%= period == '7' ? 'selected' : '' %>>7 ngày</option>
                    <option value="30" <%= period == '30' ? 'selected' : '' %>>30 ngày</option>
                    <option value="90" <%= period == '90' ? 'selected' : '' %>>90 ngày</option>
                    <option value="365" <%= period == '365' ? 'selected' : '' %>>1 năm</option>
                  </select>
                </div>
                <button type="submit" class="btn btn-primary">Lọc</button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Overview Stats -->
      <div class="row">
        <div class="col-lg-3 col-6">
          <div class="small-box bg-info">
            <div class="inner">
              <h3><%= overview.total_orders %></h3>
              <p>Tổng đơn hàng</p>
            </div>
            <div class="icon">
              <i class="ion ion-bag"></i>
            </div>
          </div>
        </div>
        
        <div class="col-lg-3 col-6">
          <div class="small-box bg-success">
            <div class="inner">
              <h3><%= overview.completed_orders %></h3>
              <p>Đơn thành công</p>
            </div>
            <div class="icon">
              <i class="ion ion-stats-bars"></i>
            </div>
          </div>
        </div>
        
        <div class="col-lg-3 col-6">
          <div class="small-box bg-warning">
            <div class="inner">
              <h3><%= overview.pending_orders %></h3>
              <p>Đơn chờ xử lý</p>
            </div>
            <div class="icon">
              <i class="ion ion-person-add"></i>
            </div>
          </div>
        </div>
        
        <div class="col-lg-3 col-6">
          <div class="small-box bg-danger">
            <div class="inner">
              <h3><%= overview.failed_orders %></h3>
              <p>Đơn thất bại</p>
            </div>
            <div class="icon">
              <i class="ion ion-pie-graph"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Revenue Stats -->
      <div class="row">
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Tổng quan doanh thu</h3>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <div class="info-box">
                    <span class="info-box-icon bg-success"><i class="fas fa-money-bill-wave"></i></span>
                    <div class="info-box-content">
                      <span class="info-box-text">Tổng doanh thu</span>
                      <span class="info-box-number"><%= Number(overview.total_revenue || 0).toLocaleString('vi-VN') %>đ</span>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="info-box">
                    <span class="info-box-icon bg-info"><i class="fas fa-chart-line"></i></span>
                    <div class="info-box-content">
                      <span class="info-box-text">Giá trị TB/đơn</span>
                      <span class="info-box-number"><%= Number(overview.avg_order_value || 0).toLocaleString('vi-VN') %>đ</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Thống kê gói subscription</h3>
            </div>
            <div class="card-body">
              <% if (planStats && planStats.length > 0) { %>
                <% planStats.forEach(plan => { %>
                  <div class="progress-group">
                    <%= plan.plan_name %>
                    <span class="float-right"><b><%= plan.order_count %></b>/<%= Number(plan.revenue).toLocaleString('vi-VN') %>đ</span>
                    <div class="progress progress-sm">
                      <div class="progress-bar bg-primary" style="width: <%= ((plan.order_count / overview.total_orders) * 100).toFixed(1) %>%"></div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <p class="text-muted">Chưa có dữ liệu gói subscription</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Daily Revenue Chart -->
      <div class="row">
        <div class="col-md-12">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Doanh thu theo ngày</h3>
            </div>
            <div class="card-body">
              <% if (dailyRevenue && dailyRevenue.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-striped">
                    <thead>
                      <tr>
                        <th>Ngày</th>
                        <th>Số đơn</th>
                        <th>Doanh thu</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% dailyRevenue.slice(0, 10).forEach(day => { %>
                        <tr>
                          <td><%= new Date(day.date).toLocaleDateString('vi-VN') %></td>
                          <td><%= day.orders %></td>
                          <td><%= Number(day.revenue).toLocaleString('vi-VN') %>đ</td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-muted">Chưa có dữ liệu doanh thu</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Orders & Top Customers -->
      <div class="row">
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Đơn hàng gần đây</h3>
            </div>
            <div class="card-body p-0">
              <% if (recentOrders && recentOrders.length > 0) { %>
                <table class="table table-sm">
                  <thead>
                    <tr>
                      <th>Mã đơn</th>
                      <th>User</th>
                      <th>Số tiền</th>
                      <th>Trạng thái</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% recentOrders.forEach(order => { %>
                      <tr>
                        <td><a href="/admin/payments/<%= order.order_id %>"><%= order.order_id %></a></td>
                        <td><%= order.username %></td>
                        <td><%= Number(order.amount).toLocaleString('vi-VN') %>đ</td>
                        <td>
                          <% 
                            let statusBadge = 'badge-secondary';
                            let statusText = order.status;
                            
                            if (order.status === 'completed') {
                              statusBadge = 'badge-success';
                              statusText = 'Thành công';
                            } else if (order.status === 'pending') {
                              statusBadge = 'badge-warning';
                              statusText = 'Chờ xử lý';
                            } else if (order.status === 'processing') {
                              statusBadge = 'badge-info';
                              statusText = 'Đang xử lý';
                            } else if (order.status === 'failed') {
                              statusBadge = 'badge-danger';
                              statusText = 'Thất bại';
                            } else if (order.status === 'cancelled') {
                              statusBadge = 'badge-secondary';
                              statusText = 'Đã hủy';
                            } else if (order.status === 'expired') {
                              statusBadge = 'badge-warning';
                              statusText = 'Hết hạn';
                            }
                          %>
                          <span class="badge <%= statusBadge %>"><%= statusText %></span>
                          
                          <% if (order.result_code && order.result_code !== 0) { %>
                            <% const resultInfo = getMoMoResultCodeInfo ? getMoMoResultCodeInfo(order.result_code) : { message: `Code ${order.result_code}` }; %>
                            <br><small class="text-muted">
                              <%= order.result_code %>: <%= resultInfo.message %>
                            </small>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="p-3 text-muted">Chưa có đơn hàng nào</p>
              <% } %>
            </div>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Top khách hàng</h3>
            </div>
            <div class="card-body p-0">
              <% if (topCustomers && topCustomers.length > 0) { %>
                <table class="table table-sm">
                  <thead>
                    <tr>
                      <th>Username</th>
                      <th>Số đơn</th>
                      <th>Tổng chi tiêu</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% topCustomers.forEach(customer => { %>
                      <tr>
                        <td><%= customer.username %></td>
                        <td><%= customer.order_count %></td>
                        <td><%= Number(customer.total_spent).toLocaleString('vi-VN') %>đ</td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="p-3 text-muted">Chưa có dữ liệu khách hàng</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</div>

<%- include('footer') %>
