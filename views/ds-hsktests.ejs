<%- include('header')%> <%- include('aside')%>

<div class="content-wrapper">
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6"><h1><%= title %></h1></div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin">Trang chủ</a></li>
            <li class="breadcrumb-item active">Đề thi HSK</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container-fluid">
      <!-- Flash Messages -->
      <% if (typeof success_msg !== 'undefined' && success_msg) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <h5><i class="icon fas fa-check"></i> Thành công!</h5>
          <%= success_msg %>
        </div>
      <% } %>
      <% if (typeof error_msg !== 'undefined' && error_msg) { %>
        <div class="alert alert-danger alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <h5><i class="icon fas fa-ban"></i> Lỗi!</h5>
          <%= error_msg %>
        </div>
      <% } %>

      <!-- Search and Filter -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Tìm kiếm và lọc</h3>
        </div>
        <div class="card-body">
          <form method="GET" class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label>Tìm kiếm</label>
                <input class="form-control" name="search" placeholder="Tìm theo tiêu đề hoặc mô tả..." value="<%= search || '' %>"/>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label>Cấp độ HSK</label>
                <select class="form-control" name="level">
                  <option value="">Tất cả cấp độ</option>
                  <% [1,2,3,4,5,6].forEach(l => { %>
                    <option value="<%= l %>" <%= String(level)===String(l)?'selected':'' %>>HSK <%= l %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label>Trạng thái</label>
                <select class="form-control" name="status">
                  <option value="">Tất cả trạng thái</option>
                  <option value="draft" <%= String(status)==='draft'?'selected':'' %>>Nháp</option>
                  <option value="public" <%= String(status)==='public'?'selected':'' %>>Công khai</option>
                  <option value="hidden" <%= String(status)==='hidden'?'selected':'' %>>Ẩn</option>
                </select>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label>&nbsp;</label>
                <div>
                  <button class="btn btn-primary" type="submit">
                    <i class="fas fa-search"></i> Tìm kiếm
                  </button>
                  <a href="/admin/hsk" class="btn btn-secondary">
                    <i class="fas fa-refresh"></i> Làm mới
                  </a>
                </div>
              </div>
            </div>
            <div class="col-md-2">
              <div class="form-group">
                <label>&nbsp;</label>
                <div>
                  <a href="/admin/hsk/add" class="btn btn-success btn-block">
                    <i class="fas fa-plus"></i> Thêm đề thi
                  </a>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Test List -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Danh sách đề thi HSK</h3>
          <div class="card-tools">
            <span class="badge badge-primary"><%= data ? data.length : 0 %> đề thi</span>
          </div>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <th width="60">ID</th>
                  <th width="80">HSK</th>
                  <th>Tiêu đề</th>
                  <th width="100">Số câu</th>
                  <th width="120">Thời gian</th>
                  <th width="100">Điểm đạt</th>
                  <th width="120">Trộn đề</th>
                  <th width="150">Trạng thái</th>
                  <th width="280">Hành động</th>
                </tr>
              </thead>
              <tbody>
                <% if (data && data.length) { %>
                  <% data.forEach(t => { %>
                    <tr>
                      <td class="text-center">
                        <span class="badge badge-secondary"><%= t.test_id %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge badge-info">HSK <%= t.hsk_level %></span>
                      </td>
                      <td>
                        <strong><%= t.title %></strong>
                        <% if (t.description) { %>
                          <br><small class="text-muted"><%= t.description.length > 100 ? t.description.substring(0, 100) + '...' : t.description %></small>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <span class="badge badge-<%= t.total_questions > 0 ? 'success' : 'warning' %>">
                          <%= t.total_questions || 0 %>
                        </span>
                      </td>
                      <td class="text-center">
                        <% if (t.time_limit) { %>
                          <span class="badge badge-info"><%= t.time_limit %> phút</span>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <span class="badge badge-<%= t.passing_score >= 60 ? 'success' : 'warning' %>">
                          <%= t.passing_score || 0 %>
                        </span>
                      </td>
                      <td class="text-center">
                        <form method="POST" action="/admin/hsk/toggle-randomize/<%= t.test_id %>" style="display:inline">
                          <input type="hidden" name="value" value="<%= t.randomize_questions ? 0 : 1 %>"/>
                          <button class="btn btn-sm <%= t.randomize_questions ? 'btn-success' : 'btn-outline-secondary' %>" type="submit">
                            <i class="fas fa-random"></i> <%= t.randomize_questions ? 'Đang bật' : 'Tắt' %>
                          </button>
                        </form>
                      </td>
                      <td class="text-center">
                        <!-- Trạng thái đề thi -->
                        <% let statusBadge = 'badge-secondary'; let statusText = 'Ẩn'; %>
                        <% if (t.status === 'public') { statusBadge = 'badge-success'; statusText = 'Công khai'; } %>
                        <% if (t.status === 'draft') { statusBadge = 'badge-warning'; statusText = 'Nháp'; } %>
                        <% if (t.status === 'hidden') { statusBadge = 'badge-secondary'; statusText = 'Ẩn'; } %>
                        
                        <form method="POST" action="/admin/hsk/toggle-status/<%= t.test_id %>" style="display:inline">
                          <select name="status" class="form-control form-control-sm" onchange="this.form.submit()">
                            <option value="draft" <%= t.status === 'draft' ? 'selected' : '' %>>Nháp</option>
                            <option value="public" <%= t.status === 'public' ? 'selected' : '' %>>Công khai</option>
                            <option value="hidden" <%= t.status === 'hidden' ? 'selected' : '' %>>Ẩn</option>
                          </select>
                        </form>
                        
                        <!-- Trạng thái hoạt động -->
                        <br>
                        <form method="POST" action="/admin/hsk/toggle-active/<%= t.test_id %>" style="display:inline">
                          <input type="hidden" name="value" value="<%= t.is_active ? 0 : 1 %>"/>
                          <button class="btn btn-sm <%= t.is_active ? 'btn-success' : 'btn-outline-danger' %>" type="submit" title="<%= t.is_active ? 'Tạm ngưng' : 'Kích hoạt' %>">
                            <i class="fas fa-<%= t.is_active ? 'check-circle' : 'times-circle' %>"></i>
                            <%= t.is_active ? 'Hoạt động' : 'Tạm ngưng' %>
                          </button>
                        </form>
                      </td>
                      <td class="text-center">
                        <div class="btn-group" role="group">

                          <a class="btn btn-sm btn-primary" href="/admin/hsk/<%= t.test_id %>/questions" title="Quản lý câu hỏi">
                            <i class="fas fa-question-circle"></i> Câu hỏi
                          </a>
                          <a class="btn btn-sm btn-warning" href="/admin/hsk/edit/<%= t.test_id %>" title="Chỉnh sửa đề thi">
                            <i class="fas fa-edit"></i> Sửa
                          </a>

                          <button class="btn btn-sm btn-danger" onclick="deleteTest(<%= t.test_id %>, '<%= t.title %>')" title="Xóa đề thi">
                            <i class="fas fa-trash"></i> Xóa
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="9" class="text-center text-muted">
                      <i class="fas fa-inbox fa-3x mb-3"></i>
                      <br>Không có đề thi nào
                      <br><small>Hãy tạo đề thi đầu tiên!</small>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Pagination -->
      <% if (totalPage > 1) { %>
        <div class="card">
          <div class="card-body">
            <nav aria-label="Page navigation">
              <ul class="pagination justify-content-center">
                <li class="page-item <%= Page === 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= Page > 1 ? Page - 1 : 1 %>&search=<%= encodeURIComponent(search||'') %>&level=<%= level||'' %>&status=<%= status||'' %>">
                    <i class="fas fa-chevron-left"></i> Trước
                  </a>
                </li>
                <% for (let i = 1; i <= totalPage; i++) { %>
                  <li class="page-item <%= i === Page ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>&search=<%= encodeURIComponent(search||'') %>&level=<%= level||'' %>&status=<%= status||'' %>"><%= i %></a>
                  </li>
                <% } %>
                <li class="page-item <%= Page === totalPage ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= Page < totalPage ? Page + 1 : totalPage %>&search=<%= encodeURIComponent(search||'') %>&level=<%= level||'' %>&status=<%= status||'' %>">
                    Sau <i class="fas fa-chevron-right"></i>
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      <% } %>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Xác nhận xóa</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p>Bạn có chắc chắn muốn xóa đề thi <strong id="testTitle"></strong>?</p>
        <p class="text-danger"><small>Hành động này không thể hoàn tác!</small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
        <form id="deleteForm" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-danger">Xóa đề thi</button>
        </form>
      </div>
    </div>
  </div>
</div>



<script>
function deleteTest(testId, testTitle) {
  document.getElementById('testTitle').textContent = testTitle;
  document.getElementById('deleteForm').action = `/admin/hsk/delete/${testId}`;
  $('#deleteModal').modal('show');
}


</script>

<%- include('footer')%>